@startdot "NLP-Pipeline"
digraph pipeline {
    splines=true
    node [
        fixedsize=true
        width=2
        fontname="sans-serif"
        fontsize=12
    ]
    edge [
        fontname="sans-serif"
        fontsize=8
        style=dotted
        color=grey
        fontcolor=grey
    ]

    subgraph steps {
        rank=same
        splines=line
        node [
            style="filled,rounded"
            shape=box
            fillcolor=lightyellow
        ]
        edge [
            style=solid
            color=default
            fontcolor=default
        ]

        s1 [label="Ingestion"]
        s2 [
            label="Preprocessing"
            style="dashed,rounded"
            color=lightgrey
            fontcolor=lightgrey
        ]
        s3 [label="De-Identification"]
        s4 [label="Annotation"]
        s1 -> s2 -> s3 -> s4
    }

    subgraph results {
        rank=same
        splines=curved
        node [
            style=filled
            shape=note
            fillcolor=lightgrey
            width=2
        ]
        edge [
            dir=back
            style=dashed
            headport=sw
            tailport=se
        ]

        r1 [label="Amanda_Alzheimer.txt"]
        r3 [label="De-ID.txt"]
        r4 [label="Annotat.zip"]

        r1 -> r3 [label="transforms"]
        r3 -> r4 [label="appends"]
    }

    s1 -> r1 [label="unprocessed"]
    s3 -> r3 [label="deid\nformat-change"]
    s4 -> r4 [label="deid\nsemantic\nsurrogated"]
}
@enddot